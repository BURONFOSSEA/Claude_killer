# Port HTTP
PORT=3000
# Identifiants de l'organisateur (créés au premier démarrage uniquement).
# Sans ADMIN_PASSWORD, un mot de passe aléatoire est généré et affiché dans la console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Clé API Anthropic pour les suggestions de l'IA (optionnel : sans clé, mode hors-ligne).
ANTHROPIC_API_KEY=
# Modèle Claude utilisé (par défaut claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Emplacement de la base SQLite
DATABASE_PATH=./data/killer.db
# Mettre à true derrière HTTPS (cookies "Secure")
COOKIE_SECURE=false
# URL publique du site (liens dans les e-mails/notifications). Sinon déduite de la requête.
PUBLIC_URL=

# ----- E-mails (SMTP) : laissez SMTP_HOST vide pour désactiver -----
# Exemples : smtp.gmail.com (587, mot de passe d'application), smtp-relay.brevo.com, smtp.office365.com…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Killer <killer@exemple.fr>

# ----- Notifications push -----
# Facultatif : sans ces clés, une paire est générée au premier démarrage et conservée en base.
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou URL https identifiant l'expéditeur des notifications
VAPID_SUBJECT=
