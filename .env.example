# Configuration du serveur LOCAL (npm run dev).
# En production, ces valeurs sont des secrets GitHub (voir README) transmis automatiquement à Supabase.

PORT=3000
# Identifiants de l'organisateur (créés au premier démarrage uniquement).
# Sans ADMIN_PASSWORD, un mot de passe aléatoire est généré et affiché dans la console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# IA (facultatif) : sans clé, mode hors-ligne (bibliothèque de défis + tirage aléatoire)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# E-mails via Brevo (facultatif)
BREVO_API_KEY=
MAIL_FROM=Killer <vous@exemple.fr>

# Adresse publique du site, pour les liens dans les notifications
SITE_URL=http://localhost:3000

# Notifications push : clés générées automatiquement si absentes
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
