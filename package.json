{
  "name": "killer-game",
  "version": "1.0.0",
  "description": "Application web pour organiser des parties de Killer, avec assistance IA (Claude).",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
